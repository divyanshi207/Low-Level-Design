class Board{
  int size;
  Pieces[][] grid;
  public Board(int size){
    this.size=size;
    grid=new Pieces[size][size];
  }
  public boolean placeMove(int row,int col, Pieces Pieces){
    if(row<0 ||  col<0 || row>=size || col>=size)
      return false;
    if(grid[row][col]!=null)
      return false;
    grid[row][col]=Pieces;
    return true;
  }
  public void printBoard(){
    for(int i=0;i<size;i++){
      for(int j=0;j<size;j++){
        if(grid[i][j]==null)
          System.out.print("- ");
        else
          System.out.print(grid[i][j].getSymbol()+" ");
      }
       System.out.println();
    }
  }
}
